from functools import lru_cache

class Solution:
    def totalWaviness(self, num1: int, num2: int) -> int:

        def solve(n: int) -> int:
            if n <= 0:
                return 0

            digits = list(map(int, str(n)))
            m = len(digits)

            @lru_cache(None)
            def dfs(pos, tight, started, length_state, a, b):
                if pos == m:
                    return (1, 0)  # (count, total_waviness)

                limit = digits[pos] if tight else 9
                total_count = 0
                total_wavy = 0

                for d in range(limit + 1):
                    ntight = tight and (d == limit)

                    if not started:
                        if d == 0:
                            cnt, wav = dfs(
                                pos + 1, ntight, False, 0, 10, 10
                            )
                            total_count += cnt
                            total_wavy += wav
                        else:
                            cnt, wav = dfs(
                                pos + 1, ntight, True, 1, d, 10
                            )
                            total_count += cnt
                            total_wavy += wav

                    else:
                        if length_state == 1:
                            cnt, wav = dfs(
                                pos + 1, ntight, True, 2, a, d
                            )
                            total_count += cnt
                            total_wavy += wav

                        else:
                            contrib = 1 if ((b > a and b > d) or (b < a and b < d)) else 0

                            cnt, wav = dfs(
                                pos + 1, ntight, True, 2, b, d
                            )

                            total_count += cnt
                            total_wavy += wav + contrib * cnt

                return (total_count, total_wavy)

            return dfs(0, True, False, 0, 10, 10)[1]

        return solve(num2) - solve(num1 - 1)
